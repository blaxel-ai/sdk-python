from enum import Enum

class {{ enum.class_info.name }}(str, Enum):
    {% for key, value in enum.values|dictsort(true) %}
    {{ key }} = "{{ value }}"
    {% endfor %}
    {# Blaxel: openapi-python-client 0.26+ names members from x-enum-varnames (EXPORT_FAILED);
       keep the value-derived names earlier SDKs exposed (FAILED) as aliases. Only plain
