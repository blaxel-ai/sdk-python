    {% if legacy != key and legacy not in keys and legacy[:1] in "ABCDEFGHIJKLMNOPQRSTUVWXYZ" and legacy | list | reject("in", "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_") | list | length == 0 %}
    {{ legacy }} = "{{ value }}"
    {% endif %}
    {% endfor %}

    def __str__(self) -> str:
        return str(self.value)

    @classmethod
    def _missing_(cls, value: object) -> "{{ enum.class_info.name }} | None":
        if isinstance(value, str):
            upper_value = value.upper()
            for member in cls:
                if member.value.upper() == upper_value:
                    return member
        return None
